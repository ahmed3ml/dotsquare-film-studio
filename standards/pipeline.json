{
  "_comment": "Production DAG used by studio/orchestrator.py. Stage order, gates and stage dependencies come from the engine (studio.py STAGES/GATES), which stays the authoritative state machine; this file says WHO creates/reviews WHAT and HOW each stage is executed. Reviewers are always different agents from creators.",
  "schema_version": "1.0",
  "reviewers": {
    "historical_research": "historical-fact-checker",
    "story_treatment": "dramaturg-reviewer",
    "screenplay": "dramaturg-reviewer",
    "visual_bible": "continuity-supervisor",
    "shot_list": "continuity-supervisor",
    "proof_of_concept": "film-quality-reviewer",
    "production_plan": "continuity-supervisor",
    "rough_cut": "film-quality-reviewer",
    "final_delivery": "film-quality-reviewer",
    "shot_media": "film-quality-reviewer",
    "dialogue_audio": "audio-reviewer",
    "audio_bed": "audio-reviewer"
  },
  "stages": {
    "research": {"kind": "document", "creator": "historical-researcher", "files": ["HISTORICAL_BIBLE.md"], "review_set": "historical_research"},
    "story": {"kind": "document", "creator": "story-developer", "files": ["STORY_TREATMENT.md"], "review_set": "story_treatment"},
    "screenplay": {"kind": "document", "creator": "screenwriter", "files": ["SCREENPLAY.md"]},
    "script_review": {"kind": "document", "creator": "screenwriter", "files": ["SCREENPLAY.md"],
                      "reports": [{"file": "reviews/SCRIPT_REVIEW.md", "agent": "script-reviewer"}], "review_set": "screenplay"},
    "directing": {"kind": "document", "creator": "film-director", "files": ["DIRECTORS_PLAN.md"]},
    "visual_development": {"kind": "document", "creator": "visual-development-supervisor",
                           "files": ["CHARACTER_BIBLE.md", "ENVIRONMENT_BIBLE.md", "VISUAL_STYLE_GUIDE.md"], "review_set": "visual_bible"},
    "storyboard": {"kind": "document", "creator": "shot-planner", "files": ["SHOT_LIST.csv"], "review_set": "shot_list",
                   "requires_prompts": true},
    "proof_of_concept": {"kind": "proof", "creator": "video-producer", "phase": "proof", "proof_shots": 1,
                         "files": ["media/proof_of_concept/PROOF_REPORT.md"], "review_set": "proof_of_concept"},
    "production_planning": {"kind": "document", "creator": "executive-producer", "files": ["PRODUCTION_PLAN.md"],
                            "review_set": "production_plan", "cost_estimate": true},
    "image_production": {"kind": "media", "items": "keyframes", "creator": "image-producer", "phase": "production"},
    "video_production": {"kind": "media", "items": "shots", "creator": "video-producer", "phase": "production"},
    "sound": {"kind": "media", "items": "audio", "creator": "sound-producer", "phase": "production"},
    "editing": {"kind": "edit", "creator": "film-editor", "files": ["EDIT_PLAN.md"],
                "reports": [{"file": "reviews/QC_ROUGH_CUT.md", "agent": "film-quality-reviewer"}], "review_set": "rough_cut"},
    "quality_control": {"kind": "final_render", "creator": "film-editor",
                        "reports": [{"file": "reviews/QC_FINAL.md", "agent": "film-quality-reviewer"}]},
    "delivery": {"kind": "document", "creator": "executive-producer", "files": ["DELIVERY_CHECKLIST.md"],
                 "review_set": "final_delivery", "export_on_approve": true}
  },
  "video_capability_preference": ["character-video", "image-to-video", "video-generation", "text-to-video"],
  "beds": {"MUSIC": "music-generation", "AMBIENCE": "sfx-generation"}
}
